{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tbwidget",
  "version": "0.1.0",
  "identifier": "com.wi.tbwidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Taskbar Metrics",
        "width": 260,
        "height": 48,
        "minWidth": 260,
        "minHeight": 40,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "focusable": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Taskbar Metrics Settings",
        "url": "/?settings=1",
        "width": 330,
        "height": 330,
        "minWidth": 330,
        "maxWidth": 330,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "visible": false,
        "focus": false,
        "focusable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
